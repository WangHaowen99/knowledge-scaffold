HUB_DATA_DIR=/data/knowledge-hub
HUB_HOST=0.0.0.0
HUB_PORT=8200
# Use the Onto authorization endpoint reachable by this service.
ONTO_AUTHZ_URL=http://127.0.0.1:8100/api/internal/hub/authorize
HUB_SERVICE_TOKEN=
HUB_DEV_ALLOW_UNAUTH=0
HUB_MAX_UPLOAD_BYTES=268435456
HUB_MAX_EXPANDED_BYTES=1073741824
HUB_MAX_FILE_BYTES=268435456
HUB_MAX_MEMBERS=10000
HUB_PENDING_TTL_SECONDS=604800
# Hub: trusted existing account service; /userinfo validates access tokens online.
HUB_AUTH_URL=http://127.0.0.1:5056
# Optional stable issuer namespace; defaults to HUB_AUTH_URL.
HUB_AUTH_ISSUER=
# HUB_SERVICE_TOKEN identifies modeling for packages and project resources.
# Additional server-only credentials must differ from it. Enable evaluation/consumer when they integrate.
HUB_EVALUATION_SERVICE_TOKEN=
HUB_CONSUMER_SERVICE_TOKEN=
