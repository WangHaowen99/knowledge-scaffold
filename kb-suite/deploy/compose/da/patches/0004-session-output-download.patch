+                .as("会话段安全化后是另一个目录").isEmpty();
+    }
+
+    @Test
+    void symlinksMayNotLeaveTheOutputDirectory() throws Exception {
+        pushFile("data.csv", CSV);
+        Path output = DaSessionWorkspace.sessionRoot(baseRoot, SESSION, true).resolve("output");
+        Path secret = Files.writeString(outside.resolve("secret.txt"), "secret");
+        symlinkOrSkip(output.resolve("escape.txt"), secret);
+        symlinkOrSkip(output.resolve("alias.csv"), output.resolve("data.csv"));
+        Path otherSession = DaSessionWorkspace.sessionRoot(baseRoot, "t1:linked", true);
+        Files.createDirectories(otherSession);
+        symlinkOrSkip(otherSession.resolve("output"), outside);
+
+        assertThat(controller.resolveOutputFile(SESSION, "escape.txt")).isEmpty();
+        assertThat(controller.resolveOutputFile(SESSION, "alias.csv")).as("链到 output 内的文件").isPresent();
+        assertThat(controller.resolveOutputFile("t1:linked", "secret.txt")).as("output 本身是链接").isEmpty();
+    }
+
+    @Test
+    void sessionRootFollowsTheSegmentSwitch() {
+        assertThat(DaSessionWorkspace.sessionRoot(baseRoot, SESSION, true))
+                .isEqualTo(baseRoot.toAbsolutePath().normalize().resolve("t1_host-1"));
+        assertThat(DaSessionWorkspace.sessionRoot(baseRoot, "..", true).getParent())
+                .isEqualTo(baseRoot.toAbsolutePath().normalize());
+        assertThat(DaSessionWorkspace.sessionRoot(baseRoot, SESSION, false))
+                .isEqualTo(baseRoot.toAbsolutePath().normalize());
+    }
+
+    @Test
+    void contentDispositionKeepsAnAsciiFallbackAndTheUtf8Name() {
+        assertThat(DaSessionOutputController.contentDisposition("a\"b (1).txt"))
+                .isEqualTo("attachment; filename=\"a_b (1).txt\"; filename*=UTF-8''a%22b%20%281%29.txt");
+        assertThat(DaSessionOutputController.contentDisposition("报告.pdf"))
+                .isEqualTo("attachment; filename=\"__.pdf\"; filename*=UTF-8''%E6%8A%A5%E5%91%8A.pdf");
