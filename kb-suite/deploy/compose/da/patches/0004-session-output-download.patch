+/**
+ * push_file 下载端点：按 {@code deepanalyze.push.download-url-template} 的缺省形态
+ * {@code /api/sessions/{sessionId}/output/{fileName}} 读出会话 output 目录里的文件。
+ *
+ * <p>push_file 把文件暂存到 {@code {workspace 基础根}/{会话段}/output/} 并回一个按模板拼的 downloadUrl，
+ * 原先由 TS 后端在共享卷上提供这个路由；引擎单独部署时没有人提供，链接是死的。本端点用同一份会话段规则
+ * （{@link DaSessionWorkspace#sessionRoot}）定位目录，所以 push_file 返回的链接原样可用。</p>
+ *
+ * <p>访问控制与 {@link DaCompatController} 一致：认证开启时校验 X-Engine-Secret（常量时间比对，
+ * 拒绝体 {error:"unauthorized"}）；属主校验同 /tasks/{sessionId}——X-Da-Session-Id（或 sessionId
+ * query）必须等于路径里的会话 id，require-session-binding=true 时未携带即 404。X-Da-Tenant-Id
+ * 不参与判定：会话工作区只按会话分目录，没有租户归属可比。认证在本类里做而不是放进
+ * DaServiceAuthFilter：那个过滤器只注册在 /api/agents/*。</p>
+ *
+ * <p>路径收口：文件名只能是 output 下的一级名字（不含分隔符、不是 . 或 ..、不是暂存中的临时文件）；
+ * 真实路径（解开符号链接后）必须仍在真实的 output 目录里、output 本身不能是指向别处的链接、
+ * 会话目录必须在基础根内。不满足一律 404，不区分原因。下载按 attachment 给出（RFC 5987 文件名，
+ * 中文名可用），带 nosniff 与 CSP sandbox，HTML/SVG 不会在引擎域下执行；Range 请求由 Spring 的
+ * Resource 处理（206/416）。</p>
+ *
+ * @since 0.1.3
+ */
+@RestController
+@ConditionalOnProperty(prefix = "deepanalyze.compat", name = "enabled", havingValue = "true", matchIfMissing = true)
+public class DaSessionOutputController {
+    /** 路由，与 download-url-template 的缺省值相同。 */
+    public static final String ROUTE = "/api/sessions/{sessionId}/output/{fileName}";
+
+    /** 会话下载目录名（与 DaSessionOutputChannel 暂存落点一致）。 */
+    static final String OUTPUT_DIR = "output";
+
+    /** push_file 发布前的暂存临时文件后缀（半成品，不对外）。 */
+    static final String STAGING_SUFFIX = ".staging";
+
+    private static final String NOT_FOUND = "File not found";
+
+    /** RFC 5987 attr-char 中除字母数字外原样保留的字符。 */
+    private static final String ATTR_CHAR_EXTRA = "!#$&+-.^_`|~";
+
+    private static final char[] HEX = "0123456789ABCDEF".toCharArray();
+
+    private static final Map<String, MediaType> EXTRA_TYPES = Map.of(
+            "md", MediaType.parseMediaType("text/markdown"),
+            "markdown", MediaType.parseMediaType("text/markdown"));
+
+    private final DaProperties properties;
+    private final DaCompatProperties compatProperties;
+    private final DaAuthProperties authProperties;
+    private final ObjectProvider<DaInitResult> initResultProvider;
+
+    /**
+     * 构造下载端点。
+     *
+     * @param properties DA 宿主配置（工作区基础根、会话段开关）
+     * @param compatProperties 兼容层配置（属主绑定开关）
+     * @param authProperties 服务间认证配置
+     * @param initResultProvider 初始化结果（未配置基础根时取 agent 工作区根，与 push_file 同口径）
+     */
+    public DaSessionOutputController(DaProperties properties, DaCompatProperties compatProperties,
+            DaAuthProperties authProperties, ObjectProvider<DaInitResult> initResultProvider) {
+        this.properties = properties;
+        this.compatProperties = compatProperties;
+        this.authProperties = authProperties;
+        this.initResultProvider = initResultProvider;
+    }
+
+    /**
+     * 读出会话 output 目录里的一个文件。
+     *
+     * @param sessionId 会话 id（与 push_file 时的会话 id 相同，未经安全化）
+     * @param fileName 下载文件名（push_file 结果里的 fileName）
+     * @param secret X-Engine-Secret header
+     * @param sessionIdHeader X-Da-Session-Id header（属主校验，优先）
+     * @param sessionIdQuery sessionId query（属主校验，兜底）
+     * @return 文件内容；401 认证失败；其余不可读一律 404
+     */
+    @GetMapping(ROUTE)
+    public ResponseEntity<?> download(@PathVariable String sessionId, @PathVariable String fileName,
+            @RequestHeader(value = DaServiceAuthFilter.SECRET_HEADER, required = false) String secret,
+            @RequestHeader(value = "X-Da-Session-Id", required = false) String sessionIdHeader,
+            @RequestParam(value = "sessionId", required = false) String sessionIdQuery) {
+        if (!isAuthenticated(secret)) {
+            return error(401, "unauthorized");
+        }
+        String presented = sessionIdHeader != null ? sessionIdHeader : sessionIdQuery;
+        boolean isDenied = presented == null ? compatProperties.isRequireSessionBinding()
+                : !sessionId.equals(presented);
+        if (isDenied) {
+            return error(404, NOT_FOUND);
+        }
+        Optional<Path> file = resolveOutputFile(sessionId, fileName);
+        if (file.isEmpty()) {
+            return error(404, NOT_FOUND);
+        }
+        Path path = file.orElseThrow();
+        return ResponseEntity.ok()
+                .contentType(mediaType(fileName))
+                .header(HttpHeaders.CONTENT_DISPOSITION, contentDisposition(fileName))
+                .header("X-Content-Type-Options", "nosniff")
+                .header("Content-Security-Policy", "sandbox")
+                .header(HttpHeaders.CACHE_CONTROL, "private")
+                .body(new FileSystemResource(path));
+    }
+
+    private boolean isAuthenticated(String presented) {
+        if (!authProperties.isEnabled()) {
+            return true;
+        }
+        String expected = authProperties.getEngineSecret();
+        if (expected == null || expected.isEmpty()) {
+            return false;
+        }
+        byte[] presentedBytes = presented == null ? new byte[0] : presented.getBytes(StandardCharsets.UTF_8);
+        return MessageDigest.isEqual(expected.getBytes(StandardCharsets.UTF_8), presentedBytes);
+    }
+
+    /**
+     * 解析可下载的文件（会话 output 下的一级普通文件，真实路径收口）。
+     *
+     * @param sessionId 会话 id
+     * @param fileName 文件名
+     * @return 真实路径；不可下载为空
+     */
+    Optional<Path> resolveOutputFile(String sessionId, String fileName) {
+        if (!isPlainName(fileName) || sessionId == null || sessionId.isBlank()) {
+            return Optional.empty();
+        }
+        Optional<Path> base = baseRoot();
+        if (base.isEmpty()) {
+            return Optional.empty();
+        }
+        Path sessionRoot = DaSessionWorkspace.sessionRoot(base.orElseThrow(), sessionId,
+                properties.getWorkspace().isSessionSegmentEnabled());
+        Path candidate = sessionRoot.resolve(OUTPUT_DIR).resolve(fileName).normalize();
+        try {
+            Path realBase = base.orElseThrow().toRealPath();
+            Path realSession = sessionRoot.toRealPath();
+            Path realOutput = sessionRoot.resolve(OUTPUT_DIR).toRealPath();
+            Path realFile = candidate.toRealPath();
+            boolean isContained = realSession.startsWith(realBase)
+                    && realOutput.equals(realSession.resolve(OUTPUT_DIR))
+                    && realOutput.equals(realFile.getParent());
+            return isContained && Files.isRegularFile(realFile) ? Optional.of(realFile) : Optional.empty();
+        } catch (IOException | SecurityException missing) {
+            return Optional.empty();
+        }
+    }
+
+    private Optional<Path> baseRoot() {
+        String configured = properties.getWorkspace().getRoot();
+        if (configured != null && !configured.isBlank()) {
+            return Optional.of(Path.of(configured).toAbsolutePath().normalize());
+        }
+        DaInitResult init = initResultProvider.getIfAvailable();
+        if (init == null || init.getDeepAgent() == null) {
+            return Optional.empty();
+        }
+        return Optional.of(DaEmbeddedTools.resolveBaseRoot(init.getDeepAgent(), properties));
+    }
+
+    private static boolean isPlainName(String fileName) {
+        return fileName != null && !fileName.isBlank() && !".".equals(fileName) && !"..".equals(fileName)
+                && fileName.indexOf('/') < 0 && fileName.indexOf('\\') < 0 && fileName.indexOf('\0') < 0
+                && !fileName.endsWith(STAGING_SUFFIX);
+    }
+
+    /**
+     * 按扩展名推断 Content-Type；文本类补 UTF-8（引擎写出的文本文件都是 UTF-8）。
+     *
+     * @param fileName 文件名
+     * @return 媒体类型
+     */
+    static MediaType mediaType(String fileName) {
+        int dot = fileName.lastIndexOf('.');
+        String extension = dot < 0 ? "" : fileName.substring(dot + 1).toLowerCase(Locale.ROOT);
+        MediaType type = Optional.ofNullable(EXTRA_TYPES.get(extension))
+                .or(() -> MediaTypeFactory.getMediaType(fileName))
+                .orElse(MediaType.APPLICATION_OCTET_STREAM);
+        boolean isText = "text".equals(type.getType()) || MediaType.APPLICATION_JSON.includes(type)
+                || MediaType.APPLICATION_XML.includes(type);
+        return isText && type.getCharset() == null ? new MediaType(type, StandardCharsets.UTF_8) : type;
+    }
+
+    /**
+     * attachment 形态的 Content-Disposition：filename 给 ASCII 兜底名，filename* 给 RFC 5987 的 UTF-8 原名。
+     *
+     * @param fileName 文件名
+     * @return 头值
+     */
+    static String contentDisposition(String fileName) {
+        StringBuilder fallback = new StringBuilder();
+        for (int i = 0; i < fileName.length(); i++) {
+            char current = fileName.charAt(i);
+            boolean isSafe = current >= 0x20 && current < 0x7f && current != '"' && current != '\\';
+            fallback.append(isSafe ? current : '_');
+        }
+        StringBuilder encoded = new StringBuilder();
+        for (byte raw : fileName.getBytes(StandardCharsets.UTF_8)) {
+            int value = raw & 0xff;
+            boolean isAttrChar = value < 0x80 && (Character.isLetterOrDigit(value)
+                    || ATTR_CHAR_EXTRA.indexOf(value) >= 0);
+            if (isAttrChar) {
+                encoded.append((char) value);
+            } else {
+                encoded.append('%').append(HEX[value >> 4]).append(HEX[value & 0x0f]);
+            }
+        }
+        return "attachment; filename=\"" + fallback + "\"; filename*=UTF-8''" + encoded;
+    }
+
+    private static ResponseEntity<Map<String, String>> error(int status, String message) {
+        return ResponseEntity.status(status).contentType(MediaType.APPLICATION_JSON)
+                .body(Map.of("error", message));
+    }
+}
