+
+    @Test
+    void mediaTypeFollowsTheExtension() {
+        assertThat(DaSessionOutputController.mediaType("r.md").toString()).isEqualTo("text/markdown;charset=UTF-8");
+        assertThat(DaSessionOutputController.mediaType("r.PDF").toString()).isEqualTo("application/pdf");
+        assertThat(DaSessionOutputController.mediaType("r.json").toString())
+                .isEqualTo("application/json;charset=UTF-8");
+        assertThat(DaSessionOutputController.mediaType("noext").toString()).isEqualTo("application/octet-stream");
