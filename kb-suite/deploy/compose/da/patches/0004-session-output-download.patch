+
+    private String pushFile(String name, byte[] content) throws IOException {
+        DaToolContextHolder.set(new DaToolContext(SESSION, "t1", List.of()));
+        try {
+            Path sessionRoot = DaSessionWorkspace.effectiveRoot(baseRoot, true);
+            Files.createDirectories(sessionRoot);
+            Files.write(sessionRoot.resolve(name), content);
+            PushResult result = new DaSessionOutputChannel(baseRoot, DaSessionOutputController.ROUTE, 1_000_000L)
+                    .pushFile(new PushFileRequest(name, "附件", null, false));
+            assertThat(result.isPushed()).as(String.valueOf(result.fields())).isTrue();
+            return String.valueOf(result.fields().get("downloadUrl"));
+        } finally {
+            DaToolContextHolder.clear();
+        }
+    }
+
+    private static MockHttpServletRequestBuilder request(String url) {
+        return get(URI.create(url)).header(DaServiceAuthFilter.SECRET_HEADER, SECRET)
+                .header("X-Da-Session-Id", SESSION);
+    }
+
+    private MockHttpServletResponse perform(MockHttpServletRequestBuilder request) throws Exception {
+        return mvc.perform(request).andReturn().getResponse();
+    }
+
+    private static void symlinkOrSkip(Path link, Path target) {
+        try {
+            Files.createSymbolicLink(link, target);
+        } catch (IOException | UnsupportedOperationException unsupported) {
+            Assumptions.abort("symbolic links unavailable: " + unsupported);
+        }
+    }
