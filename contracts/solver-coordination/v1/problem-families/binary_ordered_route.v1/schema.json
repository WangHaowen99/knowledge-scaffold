{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/solver-coordination/v1/binary_ordered_route.schema.json",
  "title": "Binary ordered option problem",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "option_domain", "max_transitions"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_order", "item_id", "quantity", "duration"],
        "properties": {
          "item_order": {"type": "integer", "minimum": 1},
          "item_id": {"type": "string", "minLength": 1},
          "quantity": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
          "duration": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
        }
      }
    },
    "option_domain": {
      "const": ["OPTION_0", "OPTION_1"]
    },
    "max_transitions": {"const": 1}
  }
}
