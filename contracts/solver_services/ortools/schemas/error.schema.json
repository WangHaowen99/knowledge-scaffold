{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/solver-services/ortools/error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "message", "retryable", "diagnostic_ref"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "category": {"enum": ["validation", "authentication", "capacity", "execution", "result", "internal"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 256},
        "retryable": {"type": "boolean"},
        "diagnostic_ref": {"type": "string", "pattern": "^diag_[A-Za-z0-9_-]{8,128}$"}
      }
    }
  }
}
