{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/solver-services/ortools/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "job_id", "request_id", "problem_type", "problem_version", "solve_outcome", "assignments", "objective_values", "assurance", "engine"],
  "properties": {
    "api_version": {"const": "ortools.solver.v1"},
    "job_id": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]{8,128}$"},
    "request_id": {"type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,96}$"},
    "problem_type": {"const": "binary_ordered_route"},
    "problem_version": {"const": "1.0"},
    "solve_outcome": {"enum": ["optimal", "feasible", "infeasible", "unbounded", "unknown"]},
    "assignments": {"type": "object"},
    "objective_values": {"type": "object", "additionalProperties": {"type": ["integer", "string", "null"]}},
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["best_bound", "gap", "certificate"],
      "properties": {
        "best_bound": {"type": ["integer", "string", "null"]},
        "gap": {"type": ["string", "null"], "pattern": "^(0|[0-9]+(?:\\.[0-9]+)?)$"},
        "certificate": {"type": ["object", "null"]}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "service_build"],
      "properties": {
        "name": {"const": "ortools-cp-sat"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "service_build": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
