{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/solver/schemas/capabilities.schema.json",
  "title": "solver.job.v1 capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_versions", "connector", "execution", "problem_families"],
  "properties": {
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "solver.job.v1"}
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "build": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["async_jobs", "cancellation", "prefer_wait"],
      "properties": {
        "async_jobs": {"const": true},
        "cancellation": {"type": "boolean"},
        "prefer_wait": {"type": "boolean"}
      }
    },
    "problem_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "versions", "features", "result_assurances", "limits"],
        "properties": {
          "name": {"const": "binary_ordered_route"},
          "versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"const": "1.0"}
          },
          "features": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["lexicographic_objective"]}
          },
          "result_assurances": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["feasible_solution", "best_bound", "gap", "certificate"]
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_payload_bytes", "max_solve_time_ms", "max_workers"],
            "properties": {
              "max_payload_bytes": {"type": "integer", "minimum": 1},
              "max_solve_time_ms": {"type": "integer", "minimum": 1},
              "max_workers": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
