{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/solver/schemas/job.schema.json",
  "title": "solver.job.v1 job",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "job_id", "request_ref", "problem_family", "family_version", "status"],
  "properties": {
    "protocol_version": {"const": "solver.job.v1"},
    "job_id": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]{8,128}$"},
    "request_ref": {"type": "string", "pattern": "^req_[A-Za-z0-9_-]{20,96}$"},
    "problem_family": {"const": "binary_ordered_route"},
    "family_version": {"const": "1.0"},
    "status": {
      "enum": ["accepted", "running", "completed", "failed", "cancelled", "attempt_lost"]
    }
  }
}
