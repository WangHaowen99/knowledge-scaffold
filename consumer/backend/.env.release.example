# Backend release configuration
# Copied into release bundles as backend/.env.example.

# ===== Authentication =====
AUTH_SERVER_URL=http://auth-server:5056
AUTH_SERVER_ADMIN_TOKEN=

# ===== MCP Server =====
MCP_SERVER_PORT=7488
MCP_TOKEN_SECRET=

# ===== Release sandbox baseline =====
SANDBOX_ENABLED=true
SANDBOX_FALLBACK_LOCAL=false
SANDBOX_SECRET_ALLOW_PLAIN_HTTP=false

# ===== Runtime limits =====
USER_MAX_COUNT=10
AUTH_USER_MAX_COUNT=10

# ===== Logging =====
LOG_LEVEL=INFO
SPEEDSCOPE_TRACE_ENABLED=false
