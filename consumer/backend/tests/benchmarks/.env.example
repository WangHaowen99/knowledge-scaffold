# =====================================================================
#   Benchmark 测试配置 — 复制为 .env 后修改
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
# =====================================================================

# ---- 后端服务 ----
BASE_URL=http://localhost:5055
STREAM_PATH=/agentic/runs/stream
SESSIONS_PATH=/agentic/sessions
# ACP 模式（通过 API_MODE=acp 启用）
ACP_EXECUTE_STREAM_PATH=/acp/runs/execute_stream
ACP_INTERACT_STREAM_PATH=/acp/runs/{run_id}/interact_stream
# ACP 子模式: execute_stream (默认，快捷流式) / stream (两步流式) / execute (两步同步)
ACP_SUBMODE=execute_stream
# 工作空间 ID（可于页面上创建自己的工作空间，隔离测试，注：请用英文ID，且记得上传skill.zip）
# 默认值: default
WORKSPACE_ID=default

# ---- 认证 ----
# 后端 API 需要 Bearer Token 认证
# 使用专门的测试账号；禁止填写生产账号或把实际凭据提交到仓库
AUTH_USERNAME=
AUTH_PASSWORD=

# ---- LLM 配置 (用于翻译 / 语言检测 / 中文混入判断) ----
# 不配置则翻译功能不可用，但基本测试仍可运行
LLM_API_KEY=
LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL_NAME=example-chat-model

# ---- 测试参数 ----
# 执行模式: agentic (默认) / acp
API_MODE=agentic

# 单独控制 ACP 传入的 lang 参数（语言跟随用）
# ACP 模式下，通过此参数告知 Agent 以指定语言输出
# 不设置则使用 TEST_LANGUAGE 的值
# 仅在 runtime_config.lang.enabled=true 时生效
ACP_LANG=

# 每个问题重复执行的次数 (默认 1)
RUNS_PER_QUESTION=1

# 执行模式: serial (串行) / parallel (并行)
# 仅当 RUNS_PER_QUESTION > 1 时生效
RUNS_EXECUTION_MODE=serial

# 并行模式下的最大并发数 (默认 4)
RUNS_MAX_CONCURRENCY=4

# 限制测试的问题数量（默认 0=全部），用于快速调试
TEST_QUESTION_LIMIT=0

# 测试组: eval / flywheel / other / all
ACTIVE_TEST_GROUP=eval

# 从评估用例中随机抽取数量，设为 0 表示全部
EVAL_SAMPLE_SIZE=2

# 测试语言: zh / en / ja / ko / 随机
# 注意: 运行 run_benchmark_multilang.py 时此项被覆盖
TEST_LANGUAGE=en

# 中文混入检测最低报告级别: info / warn / error
CHINESE_DETECT_MIN_SEVERITY=info

# ACP 互动模式自动回复内容（默认: "继续"）
ACP_AUTO_REPLY=继续

# LLM 提供商标识（仅用于写入 Excel 报告，默认: custom）
LLM_PROVIDER=custom

# 自定义结果输出目录（默认: tests/result）
BENCHMARK_RESULT_DIR=

# ---- 多语言测试 (run_benchmark_multilang.py) ----
# 逗号分隔的语言代码列表，按顺序依次执行
# 设为 all 则执行 translated_cases/ 下所有支持的语言 (含 zh)
# 默认: zh,en,ja,ko
MULTILANG_LANGUAGES=zh,en,ja,ko

# ---- ACP 全场景矩阵 (run_acp_full_matrix.py) ----
# 每个场景抽取的评估问题数（默认 1）
ACP_MATRIX_SAMPLE_SIZE=1
# 每个问题重复执行次数（默认 1）
ACP_MATRIX_RUNS=1

# =====================================================================
#   语言代码对照表 (translated_cases/ 目录下的可用语言)
# =====================================================================
#
#   代码     中文          代码     中文          代码     中文
#   ----     ----          ----     ----          ----     ----
#   zh       中文          en       英文          ja       日文
#   ko       韩文          ru       俄文          de       德文
#   fr       法文          es       西班牙文      pt       葡萄牙文
#   ar       阿拉伯文      it       意大利文      nl       荷兰文
#   pl       波兰文        tr       土耳其文      vi       越南文
#   th       泰文          hi       印地文        id       印尼文
#   uk       乌克兰文      cs       捷克文
#
#   示例:
#     中英日韩 (默认):  MULTILANG_LANGUAGES=zh,en,ja,ko
#     中英法德:          MULTILANG_LANGUAGES=zh,en,fr,de
#     仅中文和英文:      MULTILANG_LANGUAGES=zh,en
# =====================================================================
