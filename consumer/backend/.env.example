# Backend configuration
# Copy to .env before local or Docker runs.

# ===== Main LLM =====
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
LLM_TIMEOUT=600
LLM_MAX_TOKENS=32768
LLM_TEMPERATURE=0.7

# ===== Task LLM (optional; endpoint/model/key fall back to main LLM) =====
# TASK_LLM_BASE_URL=
# TASK_LLM_MODEL=
# TASK_LLM_API_KEY=
# TASK_LLM_TIMEOUT=
# TASK_LLM_MAX_TOKENS=8192
# TASK_LLM_TEMPERATURE=0.7

# ===== Storage =====
# Defaults to <PROJECT_ROOT>/data/chats and <PROJECT_ROOT>/data/executions
# in local runs, and /app/.onto-runtime/data/* in release containers.
# CHAT_STORAGE_DIR=
# EXECUTION_STORAGE_DIR=

# ===== Tool path root =====
# Runtime root containing `system/` and `workspaces/`.
# Defaults to <repo>/.onto-runtime.
# PROJECT_ROOT=../.onto-runtime
# Saved system config defaults to <PROJECT_ROOT>/config/system_config.json.
# SYSTEM_CONFIG_PATH=../.onto-runtime/config/system_config.json
# Deployment operations config defaults to <PROJECT_ROOT>/config/ops_config.json.
# OPS_CONFIG_PATH=../.onto-runtime/config/ops_config.json

# ===== Authentication (remote auth server, ADR 2026-07-09) =====
# 鉴权唯一路径为独立 auth-server（remote），backend 通过容器网络对接，无内置认证回退。
# 【必需】auth-server 内网地址
AUTH_SERVER_URL=http://auth-server:5056
# 【必需】与 auth-server 的 AUTH_SERVER_ADMIN_TOKEN 一致的共享管理令牌
AUTH_SERVER_ADMIN_TOKEN=
# 【首次部署必需】管理员初始密码；使用独立强密码，users.json 创建后可移除
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# 自助注册默认开启；不允许用户自行建号时设为 false
AUTH_ENABLE_REGISTRATION=true
# 可选：Modeling 评测需要。须与 modeling 的同名值一致，至少 32 个随机字符；
# 仅授权创建/确认 mw-shadow-* 影子工作区，不等同于全局管理员 Token。
MODELING_SERVICE_TOKEN=
MODELING_MCP_TOKEN_SECRET=
MODELING_MCP_PUBLIC_BASE_URL=http://localhost:5188
MODELING_MCP_ALLOWED_ORIGINS=http://localhost:5100,http://127.0.0.1:5100
MODELING_MCP_OPERATION_RULE_ENABLED=false
# 可选：JWT 校验的 audience / issuer（缺省沿用 auth-server 默认值）
# AUTH_SERVER_AUDIENCE=meta-wise
# AUTH_SERVER_ISSUER=
# Base64-encoded 32-byte key for encrypting stored API keys and data connection secrets.
# If unset, local single-node runtime generates <PROJECT_ROOT>/config/secret.key.
# SECRET_ENCRYPTION_KEY=

# ===== MCP Server (standalone process) =====
# Start with: PYTHONPATH=. python -m api.protocols.mcp.server
# MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=7488
# Externally reachable base URL only; workspace endpoint ids are appended automatically.
# Example client URL: https://mcp.example.com/<mcp_endpoint_id>/chat/mcp
# MCP_PUBLIC_BASE_URL=http://127.0.0.1:7488
# Supported values: both, streamable-http, sse
# MCP_TRANSPORT=both
# MCP_AGENTIC_BASE_URL=http://127.0.0.1:5055
# Optional YAML service catalog. Defaults to backend/config/mcp_services.yaml when present.
# MCP_SERVICES_CONFIG_FILE=config/mcp_services.yaml
# Required when MCP is enabled. Use an independent random value of at least 32 characters.
# MCP_TOKEN_SECRET=
# MCP_TOKEN_ALGORITHM=HS256
# MCP_TOKEN_ISSUER=meta-wise
# MCP_TOKEN_AUDIENCE=meta-wise-mcp
# MCP_TOKEN_TTL_SECONDS=86400
# MCP_TOKEN_MAX_TTL_SECONDS=2592000
# MCP_TOKEN_STORE_PATH=../.onto-runtime/mcp-tokens.json
# Limits for the compact Trace returned when chat(include_trace=true).
MCP_CHAT_TRACE_MAX_EVENTS=30
MCP_CHAT_TRACE_MAX_BYTES=32768
MCP_CHAT_TRACE_MAX_TEXT_CHARS=500

# ===== Agent runtime =====
AGENT_MAIN_LOOP_MAX_ITERATIONS=50
AGENT_SUB_AGENT_MAX_ITERATIONS=20
AGENT_PARALLEL_DEFAULT_MAX_WORKERS=10
AGENT_CONTEXT_MAX_ROUNDS=10
# AGENT_REACT_ENGINE=native
# EXECUTE_SCRIPT_TIMEOUT=300
# AGENT_LLM_CONNECTION_MAX_RETRIES=3
# AGENT_LLM_STRUCTURED_OUTPUT_MAX_RETRIES=2

# ===== Optional JiuwenBox script execution =====
# legacy (default): keep local execution for maximum provider compatibility.
# prefer: try JiuwenBox first and audit any fallback to local execution.
# SANDBOX_EXECUTION_MODE=legacy
# Compatibility knobs for deployments created before SANDBOX_EXECUTION_MODE.
# They are used only when SANDBOX_EXECUTION_MODE is unset.
# SANDBOX_ENABLED=false
# SANDBOX_FALLBACK_LOCAL=true
# SANDBOX_SECRET_ALLOW_PLAIN_HTTP=true

# ===== Public Web Search (optional; default off) =====
# WEB_SEARCH_ENABLED=false
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_BASE_URL=https://api.tavily.com
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_TIMEOUT_SECONDS=20
# WEB_SEARCH_DEFAULT_MAX_RESULTS=5
# WEB_SEARCH_MAX_RESULTS_LIMIT=10
# WEB_SEARCH_DEPTH=basic
# WEB_SEARCH_ALLOWED_DOMAINS=
# WEB_SEARCH_BLOCKED_DOMAINS=

# ===== Deployment operations policy =====
# These are read from ops_config.json first when present, then env, then defaults.
# AGENT_RUN_TPS=50
# WORKSPACE_MAX_COUNT=50
# ONTOLOGY_MAX_COUNT_PER_WORKSPACE=10
# ONTOLOGY_OBJECT_MAX_COUNT=200
# ONTOLOGY_OPERATION_MAX_COUNT=100
# ENTITY_ATTRIBUTE_MAX_COUNT=100
# DATA_CONNECTION_CONFIGS_MAX_PER_WORKSPACE=10
# MODEL_PROFILE_MAX_COUNT=10
# MODEL_INPUT_TOKEN_LIMIT=50000
# MODEL_OUTPUT_TOKEN_LIMIT=100000
# SESSION_MAX_PER_USER_WORKSPACE=100
# ONTOLOGY_OPERATION_MAX_CHARS=15000
# 仅截断后的工具输出会落盘；以下限制同时约束单条、单 Run 和单 Session。
# TOOL_OUTPUT_MAX_BYTES=10485760
# TOOL_OUTPUT_RUN_MAX_BYTES=67108864
# TOOL_OUTPUT_SESSION_MAX_BYTES=268435456
# TOOL_OUTPUT_RUN_MAX_COUNT=64
# TOOL_OUTPUT_SESSION_MAX_COUNT=256
# AGENT_LOG_RETENTION_DAYS=180
# AGENT_LOG_COMPRESS_OLD=true

# ===== Direct Script Execution =====
# When enabled, the orchestrator attempts to bypass the AgentLoopEngine for
# clear-cut script-type ontology operations (POC stage, default off).
# DIRECT_EXECUTION_ENABLED=false
# Deterministic Parser/Handler execution requires JiuwenBox. When this flag is
# true, SANDBOX_ENABLED=true (or SANDBOX_EXECUTION_MODE=prefer) must also be set;
# deterministic calls never use SANDBOX_FALLBACK_LOCAL.
# DETERMINISTIC_EXECUTION_ENABLED=false
# Full-stack Compose configures this shared backend/JiuwenBox path itself. For
# custom two-container deployments, mount the same absolute path read-write in
# both containers and set it on the backend.
# DETERMINISTIC_ARTIFACT_STAGING_ROOT=/run/onto-deterministic-artifacts
# DIRECT_EXECUTION_SELECTED_ONTOLOGY_ONLY=true

# ===== Memory (OpenViking) =====
# OPENVIKING_WORKSPACE_ROOT=
# AGENT_MEMORY_RECALL_TOPK=3
# AGENT_MEMORY_RECALL_THRESHOLD=

# ===== Logging =====
LOG_LEVEL=INFO
# LOG_CONSOLE=1
# LOG_STRUCTURED=0
# LOG_REQUEST_BODY=0
# LOG_RESPONSE_BODY=0
# LOG_DIR=logs
# LOG_FILE=agent.log
# LOG_MAX_BYTES=
# LOG_BACKUP_COUNT=
# SCRIPT_LIVE_LOG_ENABLED=false

# ===== Developer-only Speedscope timing traces (default off) =====
# Writes one standard .speedscope.json file per knowledge-QA session under
# <PROJECT_ROOT>/logs/speedscope. Prompt, reasoning, answer, arguments, and
# tool output content are never written to these files.
SPEEDSCOPE_TRACE_ENABLED=false
