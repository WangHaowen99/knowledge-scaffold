# Configuration placeholders only. Inject protected values outside the repository.
EVAL_AUTH_URL=https://accounts.example.com
EVAL_AUTH_ISSUER=https://accounts.example.com
EVAL_HUB_URL=https://hub.example.com
EVAL_HUB_SERVICE_TOKEN=${HUB_EVALUATION_SERVICE_TOKEN}
EVAL_CONSUMER_API_URL=https://consumer.example.com
EVAL_CONSUMER_SERVICE_TOKEN=${EVALUATION_SERVICE_TOKEN}
EVAL_ENCRYPTION_KEY=${SECRET_NAME}
EVAL_JUDGE_BASE_URL=https://models.example.com/v1
EVAL_JUDGE_API_KEY=${API_TOKEN}
EVAL_JUDGE_MODEL=judge-model
EVAL_JUDGE_CONFIG_REVISION=1
# Optional dataset adapter: JSON configuration for the managed MySQL server.
EVAL_SQL_CONFIG=${DATABASE_CONFIG}
# Consumer-reachable URL, routed directly to the evaluation service.
EVAL_NL2SQL_URL=https://service.example.net/evaluation/api/nl2sql
# Completion notifications to onto-modeling give up after this many deliveries (default 30, about a day).
EVAL_NOTIFICATION_MAX_ATTEMPTS=30
# Hosts a judge gateway may use although they resolve to a loopback or private address, comma-separated.
EVAL_JUDGE_ALLOWED_HOSTS=models.internal.example
# Consumer feedback (data flywheel). Off unless true; the token equals consumer's FLYWHEEL_SERVICE_TOKEN.
EVAL_FEEDBACK_ENABLED=false
EVAL_FLYWHEEL_SERVICE_TOKEN=${FLYWHEEL_SERVICE_TOKEN}
# Announce confirmed feedback runs to onto-modeling once it files notifications by source.
EVAL_NOTIFY_FEEDBACK_RUNS=false
EVAL_FEEDBACK_RETENTION_DAYS=90
# A cluster of thumbs-down only is handed over when this many users, or this many votes, came in the window.
EVAL_FEEDBACK_WINDOW_DAYS=7
EVAL_FEEDBACK_L1_MIN_USERS=3
EVAL_FEEDBACK_L1_MIN_DOWNVOTES=5
# A collecting feedback run is sealed at this many clusters, or after this many idle minutes.
EVAL_FEEDBACK_SEAL_CLUSTERS=10
EVAL_FEEDBACK_SEAL_IDLE_MINUTES=60
