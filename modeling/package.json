{
  "name": "modeling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "知识包建模工具 —— 基于 pi agent 的动态 workflow 交互式建模服务",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"const f=require('fs');f.mkdirSync('dist/db',{recursive:true});f.copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke-nodes.ts",
    "smoke:m2": "tsx scripts/smoke-m2.ts",
    "smoke:m3": "MODELING_LLM_BASE_URL=faux tsx scripts/smoke-m3.ts",
    "smoke:m4": "MODELING_LLM_BASE_URL=faux tsx scripts/smoke-m4.ts",
    "smoke:check": "MODELING_LLM_BASE_URL=faux tsx scripts/smoke-check.ts",
    "check:llm": "tsx --env-file=.env scripts/check-llm.ts",
    "smoke:real": "tsx --env-file=.env scripts/smoke-real.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.3",
    "@earendil-works/pi-ai": "^0.80.3",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.1.0",
    "fflate": "^0.8.2",
    "jose": "^6.2.3",
    "mammoth": "^1.8.0",
    "mysql2": "^3.22.6",
    "neo4j-driver": "^6.2.0",
    "pdf-parse": "^1.1.1",
    "undici": "^8.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "puppeteer-core": "^25.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
