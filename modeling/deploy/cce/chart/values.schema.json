{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "externalAuth", "externalConsumer", "modeling", "hub", "evaluation"],
  "properties": {
    "global": {
      "type": "object", "additionalProperties": false,
      "required": ["clusterFlavor", "targetArch", "imageDelivery", "resolvedImages", "auth", "access"],
      "properties": {
        "releaseVersion": {"type": "string"},
        "operationId": {"type": "string"},
        "clusterFlavor": {"enum": ["standard", "turbo"]},
        "targetArch": {"enum": ["amd64", "arm64"]},
        "imageDelivery": {"type": "object", "additionalProperties": false, "required": ["pullSecretNames"], "properties": {"pullSecretNames": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
        "resolvedImages": {"type": "object", "additionalProperties": false, "required": ["ontoModeling", "knowledgeHub", "evaluation", "jiuwenbox"], "properties": {
          "ontoModeling": {"$ref": "#/definitions/image"}, "knowledgeHub": {"$ref": "#/definitions/image"}, "evaluation": {"$ref": "#/definitions/image"}, "jiuwenbox": {"$ref": "#/definitions/image"}
        }},
        "auth": {"type": "object", "additionalProperties": false, "required": ["issuer", "audience"], "properties": {"issuer": {"type": "string", "minLength": 1}, "audience": {"type": "string", "minLength": 1}}},
        "access": {"type": "object", "additionalProperties": false, "required": ["mode", "elb", "protocol", "listenerPort", "tlsSecretName", "ingressClassName", "routes", "listeners"], "properties": {
          "mode": {"enum": ["host", "port"]},
          "elb": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "class": {"type": "string"}}},
          "protocol": {"enum": ["HTTP", "HTTPS"]}, "listenerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
          "tlsSecretName": {"type": "string"}, "ingressClassName": {"type": "string"},
          "routes": {"type": "array", "minItems": 0, "items": {"type": "object", "additionalProperties": false,
            "required": ["id", "host", "path", "pathType", "endpointId"],
            "properties": {"id": {"type": "string", "minLength": 1}, "host": {"type": "string"}, "path": {"type": "string", "pattern": "^/"}, "pathType": {"const": "Prefix"}, "endpointId": {"enum": ["onto-modeling", "evaluation"]}}
          }},
          "listeners": {"type": "array", "items": {"type": "object", "additionalProperties": false,
            "required": ["id", "protocol", "listenerPort", "tlsSecretName", "host", "path", "pathType", "endpointId"],
            "properties": {"id": {"type": "string", "minLength": 1}, "protocol": {"enum": ["HTTP", "HTTPS"]},
              "listenerPort": {"type": "integer", "minimum": 1, "maximum": 65535}, "tlsSecretName": {"type": "string"},
              "host": {"type": "string"}, "path": {"type": "string", "pattern": "^/"}, "pathType": {"const": "Prefix"},
              "endpointId": {"enum": ["onto-modeling", "evaluation"]}}
          }}
        }}
      }
    },
    "externalAuth": {"$ref": "#/definitions/externalAuthService"},
    "externalConsumer": {"$ref": "#/definitions/externalService"},
    "modeling": {"type": "object", "additionalProperties": false, "required": ["config", "workloads", "secrets"], "properties": {
      "config": {"type": "object", "additionalProperties": false, "required": ["ontoJiuwenBaseUrl", "ontoJiuwenModel", "ontoAnthropicBaseUrl"], "properties": {
        "ontoJiuwenBaseUrl": {"type": "string"}, "ontoJiuwenModel": {"type": "string"}, "ontoAnthropicBaseUrl": {"type": "string"}, "evalPublicUrl": {"type": "string"}
      }},
      "workloads": {"type": "object", "additionalProperties": false, "required": ["onto", "jiuwenbox"], "properties": {
        "onto": {"$ref": "#/definitions/statefulWorkload"},
        "jiuwenbox": {"type": "object", "additionalProperties": false, "required": ["nodeSelector", "runtimeClassName", "resources"], "properties": {
          "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}}, "runtimeClassName": {"type": "string"}, "resources": {"type": "object"}
        }},
        "sandboxGateway": {"type": "object", "additionalProperties": false, "required": ["resources"], "properties": {
          "resources": {"type": "object"}
        }}
      }},
    "secrets": {"type": "object", "additionalProperties": false, "required": ["authAdminToken", "anthropicAuthToken"], "properties": {
        "authAdminToken": {"$ref": "#/definitions/optionalSecretRef"},
        "anthropicAuthToken": {"$ref": "#/definitions/optionalSecretRef"}
      }}
    }},
    "hub": {"type": "object", "additionalProperties": false, "required": ["replicas", "persistence", "resources", "secrets"], "properties": {
      "replicas": {"type": "integer", "minimum": 0, "maximum": 1}, "persistence": {"$ref": "#/definitions/persistence"}, "resources": {"type": "object"},
      "secrets": {"type": "object", "additionalProperties": false, "required": ["internal", "consumerToken"], "properties": {"internal": {"$ref": "#/definitions/hubInternalSecretRef"}, "consumerToken": {"$ref": "#/definitions/importableSecretRef"}}}
    }},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["replicas", "persistence", "resources", "trustedOrigins", "judge", "secrets"], "properties": {
      "replicas": {"type": "integer", "minimum": 0, "maximum": 1}, "persistence": {"$ref": "#/definitions/persistence"}, "resources": {"type": "object"}, "trustedOrigins": {"type": "array", "items": {"type": "string"}},
      "feedback": {"type": "object", "additionalProperties": false, "required": ["enabled", "notifyRuns"], "properties": {"enabled": {"type": "boolean"}, "notifyRuns": {"type": "boolean"}}},
      "judge": {"type": "object", "additionalProperties": false, "required": ["baseUrl", "model", "configRevision"], "properties": {"baseUrl": {"type": "string"}, "model": {"type": "string"}, "configRevision": {"type": "string"}}},
      "secrets": {"type": "object", "additionalProperties": false, "required": ["encryptionKey", "notificationToken", "consumerToken", "judgeApiKey", "sqlConfig"], "properties": {"encryptionKey": {"$ref": "#/definitions/secretRef"}, "notificationToken": {"$ref": "#/definitions/optionalSecretRef"}, "consumerToken": {"$ref": "#/definitions/importableSecretRef"}, "flywheelToken": {"$ref": "#/definitions/importableSecretRef"}, "judgeApiKey": {"$ref": "#/definitions/importableSecretRef"}, "sqlConfig": {"$ref": "#/definitions/importableSecretRef"}}}
    }}
  },
  "definitions": {
    "image": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"},
    "secretRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}},
    "hubInternalSecretRef": {"type": "object", "additionalProperties": false, "required": ["name", "modelingTokenKey", "evaluationTokenKey"], "properties": {"name": {"type": "string", "minLength": 1}, "modelingTokenKey": {"type": "string", "minLength": 1}, "evaluationTokenKey": {"type": "string", "minLength": 1}}},
    "optionalSecretRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"type": "string"}, "key": {"type": "string"}}},
    "importableSecretRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"type": "string"}, "key": {"type": "string"}, "sourceRef": {"type": "object", "additionalProperties": false, "required": ["namespace", "name", "key"], "properties": {"namespace": {"type": "string"}, "name": {"type": "string"}, "key": {"type": "string"}}}}},
    "persistence": {"type": "object", "additionalProperties": false, "required": ["existingClaim"], "properties": {"existingClaim": {"type": "string", "minLength": 1}}},
    "externalService": {"type": "object", "additionalProperties": false, "required": ["serviceName", "namespace", "servicePort"], "properties": {
      "serviceName": {"type": "string", "minLength": 1}, "namespace": {"type": "string", "minLength": 1}, "servicePort": {"type": "integer", "minimum": 1, "maximum": 65535}
    }},
    "externalAuthService": {"type": "object", "additionalProperties": false, "required": ["serviceName", "namespace", "servicePort", "apiVersion"], "properties": {
      "serviceName": {"type": "string", "minLength": 1}, "namespace": {"type": "string", "minLength": 1}, "servicePort": {"const": 5056}, "apiVersion": {"enum": ["v1", "auth-v1"]}
    }},
    "statefulWorkload": {"type": "object", "additionalProperties": false, "required": ["replicas", "nodeSelector", "persistence", "resources"], "properties": {
      "replicas": {"type": "integer", "minimum": 0, "maximum": 1},
      "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
      "persistence": {"type": "object", "additionalProperties": false, "required": ["existingClaim"], "properties": {"existingClaim": {"type": "string", "minLength": 1}}},
      "resources": {"type": "object"}
    }}
  }
}
