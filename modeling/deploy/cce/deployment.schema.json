{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "cluster", "stateDir", "compatibilityFile", "consumer", "modeling"],
  "properties": {
    "schemaVersion": {"const": "cce-joint/v1"},
    "cluster": {"type": "object", "additionalProperties": false, "required": ["context"], "properties": {"context": {"type": "string", "minLength": 1}}},
    "stateDir": {"type": "string", "minLength": 1},
    "compatibilityFile": {"type": "string", "minLength": 1},
    "timeoutSeconds": {"type": "integer", "minimum": 1},
    "auth": {"type": "object", "additionalProperties": false,
      "required": ["package", "releaseName", "namespace", "values", "image"],
      "properties": {"package": {"type": "string", "minLength": 1},
        "releaseName": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "values": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1}}},
    "consumer": {"$ref": "#/definitions/side"},
    "modeling": {"$ref": "#/definitions/side"}
  },
  "definitions": {"side": {"type": "object", "additionalProperties": false,
    "required": ["package", "releaseName", "namespace", "values", "resolvedImages"],
    "properties": {"package": {"type": "string", "minLength": 1}, "releaseName": {"type": "string", "minLength": 1},
      "namespace": {"type": "string", "minLength": 1}, "values": {"type": "string", "minLength": 1},
      "resolvedImages": {"type": "string", "minLength": 1}}
  }}
}
