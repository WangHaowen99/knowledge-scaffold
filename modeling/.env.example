# 知识包建模工具配置样例。复制为 .env 后按需修改：cp .env.example .env
# 启动（Node 22 需 sqlite 实验开关）：
#   NODE_OPTIONS=--experimental-sqlite node --env-file=.env node_modules/.bin/tsx src/server.ts

# ---- LLM（建模 agent 用，OpenAI-compatible 端点；作为所有用户的部署默认值）----
# 试玩模式：填 faux（脚本化假建模者，无需 key，全流程可跑）
#   MODELING_LLM_BASE_URL=faux
#   MODELING_LLM_MODEL=faux
# DeepSeek 示例：
#   MODELING_LLM_BASE_URL=https://api.deepseek.com
#   MODELING_LLM_MODEL=deepseek-chat
# GLM（智谱）示例：
#   MODELING_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   MODELING_LLM_MODEL=glm-4.7
MODELING_LLM_BASE_URL=https://api.deepseek.com
MODELING_LLM_MODEL=deepseek-chat
MODELING_LLM_API_KEY=
# 输出上限与输入+输出总上下文窗口分开设置；上下文值按所选模型 API 的实际上限填写。
MODELING_LLM_MAX_TOKENS=128000
MODELING_LLM_CONTEXT_WINDOW=1000000

# 产品/规则大清单台账门禁：off 保留旧行为，advisory 记录并提示，enforce
# 仅对明确提交的大清单台账阻断统计不一致的正式规则批次。
MODELING_PRODUCT_LEDGER_MODE=advisory

# 知识结构生成阶段受控并发；遇到模型平台限流时可降低。每项上限为 8。
MODELING_OBJECT_GENERATION_CONCURRENCY=4
MODELING_KNOWLEDGE_GENERATION_CONCURRENCY=4
MODELING_OPERATION_GENERATION_CONCURRENCY=3

# 可选轻量模型（M3 的 Judge / 摘要优先使用；留空复用主模型）
MODELING_TASK_LLM_BASE_URL=
MODELING_TASK_LLM_MODEL=
MODELING_TASK_LLM_API_KEY=

# 可选：admin 在配置中心保存“平台默认 LLM”API Key 时使用的显式加密主密钥。
# 为空时 Modeling 会在 DATA_DIR 自动生成持久化密钥；生产环境仍建议由 secret manager 注入至少 32 字节的高熵随机值。
# 无论采用哪种方式，密钥丢失后数据库中的 Key 都无法解密。
MODELING_LLM_CONFIG_ENCRYPTION_KEY=

# ---- 认证（直连独立 auth-server，见 docs/design.md 决策 3）----
# issuer=auth-server：登录走 OAuth2 /token（password/refresh 两种 grant），校验用 JWKS
# 本地 RS256 验签；注册一步转发 auth-server 的 /register（一步建号、无邮箱验证码，默认开启，
# 可用 AUTH_ENABLE_REGISTRATION=false 关闭，见 auth-server/README.md）。本机开发指向本机 auth-server；docker
# compose 内用服务名，如 http://auth-server:5056。部署时固定（页面不可改，避免凭据转发到任意地址）。
AUTH_ISSUER_URL=http://localhost:5056

# 验签期望值：AUTH_JWT_ISSUER 须与 auth-server 的 AUTH_SERVER_ISSUER 取值一致
# （容器内外地址可能不同，auth-server 默认签 http://auth-server:5056；留空则取
# AUTH_ISSUER_URL）；AUTH_JWT_AUDIENCE 须与 AUTH_SERVER_AUDIENCE 一致。
# AUTH_JWT_ISSUER=http://auth-server:5056
# AUTH_JWT_AUDIENCE=meta-wise

# ---- 评测用 consumer 业务 API 地址（评测闭环 import-zip / runs·sync 用）----
# 与登录 auth-server 是两个不同服务。仅作默认值：登录后可在页面「⚙ 设置」覆盖
# （优先级：页面设置 > 此项）。consumer 须与本工具信任同一 auth-server（remote 模式），
# 专家 token 才能跨服务通过校验。
CONSUMER_API_URL=http://localhost:5055
# Modeling 调用 Consumer 的长任务绝对超时（毫秒），默认 45 分钟。
MODELING_CONSUMER_REQUEST_TIMEOUT_MS=2700000

# Modeling 读取评测 Trace、按归属创建影子工作区时使用的受限机器凭据。
# 须与 Consumer 配置一致，且至少 32 个字符；不会下发到浏览器。
MODELING_SERVICE_TOKEN=

# ---- Modeling MCP（由 Modeling 主进程同时监听独立端口）----
MODELING_MCP_HOST=127.0.0.1
MODELING_MCP_PORT=5188
MODELING_MCP_TRANSPORT=both
MODELING_MCP_SUPPORTED_PROTOCOL_VERSIONS=2026-07-28,2025-11-25,2025-06-18
MODELING_MCP_PROTOCOL_COMPATIBILITY=true
# 本机开发可使用 http://127.0.0.1:5188；跨机器或 Dify Cloud 必须配置可访问的 HTTPS 地址。
MODELING_MCP_PUBLIC_BASE_URL=http://127.0.0.1:5188
# 生产必须由 secret manager 注入至少 32 字符。
MODELING_MCP_TOKEN_SECRET=
# Operation / Rule 默认作为正式能力开放；紧急隔离时可显式关闭。
MODELING_MCP_OPERATION_RULE_ENABLED=true
MODELING_MCP_MAX_SSE_SESSIONS=10000
MODELING_MCP_MAX_SSE_SESSIONS_PER_TOKEN=20
MODELING_MCP_MAX_SSE_SESSIONS_PER_PROJECT=200
MODELING_MCP_MAX_SSE_SESSIONS_PER_USER=100
MODELING_MCP_MAX_SSE_SESSIONS_PER_IP=100
MODELING_MCP_SSE_MAX_LIFETIME_SECONDS=28800
MODELING_MCP_SSE_IDLE_TIMEOUT_SECONDS=1800

# ---- 服务 ----
PORT=5100
DATA_DIR=./data

# ---- NL2SQL 桥接服务（scripts/nl2sql-service.ts，见 docs/real-e2e-setup.md）----
# NL2SQL 服务查询、modeling 新建项目数据库和 Excel 导入共用 EVAL_DB_URL。
# 项目仅通过 Scene 区分数据库；账号需具备建库、建表、写入和原子重命名权限。
# 建库和导入确认框可为单次项目操作提供其他 URL，不会修改本变量；页面预览会隐藏密码。
# EVAL_DB_URL=mysql://root:<strong-eval-password>@localhost:3306
# NL2SQL_PORT=5600
# NL2SQL_TOKEN=改成你自己的token
# NL2SQL_DEFAULT_SCENE=example_scene
