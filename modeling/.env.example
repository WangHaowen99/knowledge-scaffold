# 知识包建模工具配置样例。复制为 .env 后按需修改：cp .env.example .env
# 启动（Node 22 需 sqlite 实验开关）：
#   NODE_OPTIONS=--experimental-sqlite node --env-file=.env node_modules/.bin/tsx src/server.ts

# ---- LLM（建模 agent 用，OpenAI-compatible 端点）----
# 试玩模式：填 faux（脚本化假建模者，无需 key，全流程可跑）
#   MODELING_LLM_BASE_URL=faux
#   MODELING_LLM_MODEL=faux
# DeepSeek 示例：
#   MODELING_LLM_BASE_URL=https://api.deepseek.com
#   MODELING_LLM_MODEL=deepseek-chat
# GLM（智谱）示例：
#   MODELING_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   MODELING_LLM_MODEL=glm-4.7
MODELING_LLM_BASE_URL=https://api.deepseek.com
MODELING_LLM_MODEL=deepseek-chat
MODELING_LLM_API_KEY=

# 可选轻量模型（M3 的 Judge / 摘要优先使用；留空复用主模型）
MODELING_TASK_LLM_BASE_URL=
MODELING_TASK_LLM_MODEL=
MODELING_TASK_LLM_API_KEY=

# ---- 认证（AuthClient · OIDC 形状）----
# 登录走哪个 consumer，部署时固定（页面不可改，避免凭据转发到任意地址）。
# 本机开发指向本机 consumer；docker compose 内用服务名，如 http://consumer:5055
AUTH_ISSUER_URL=http://localhost:5055
AUTH_VERIFY_MODE=introspect

# ---- 评测用 consumer API 默认地址 ----
# 仅作默认值：登录后可在页面「⚙ 设置」覆盖（优先级：页面设置 > 此项 > issuer）
CONSUMER_API_URL=http://localhost:5055

# ---- 评测库（M3 评测闭环起用，当前可留空）----
EVAL_DB_URL=mysql://root:REPLACE_WITH_STRONG_PASSWORD@localhost:3306

# ---- 服务 ----
PORT=5100
DATA_DIR=./data
