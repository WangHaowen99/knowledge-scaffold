# 模型接入（私有网关时设置；值为占位符，勿填真实凭据后提交）
ANTHROPIC_BASE_URL=https://gateway.example.com
ANTHROPIC_AUTH_TOKEN=replace-with-real-token-at-runtime
# 直连官方接口时用 API Key（与上面的网关令牌二选一；同样只在运行时填）
# ANTHROPIC_API_KEY=
# 扩展思考 token 上限（新会话生效），0 关闭
# ONTO_WEB_MAX_THINKING_TOKENS=

# 关闭捆绑 CLI 自动更新（离线交付必须）
DISABLE_AUTOUPDATER=1

# 服务配置
ONTO_WEB_HOST=0.0.0.0
ONTO_WEB_PORT=5100
# 开发热重载：直接 python run.py 时默认 1，容器与 compose 里为 0
# ONTO_WEB_RELOAD=0
# 前端构建产物目录（缺省 frontend/dist；镜像内为 /opt/onto-modeling/static）
# ONTO_WEB_STATIC_DIR=
# ONTO_WEB_DATA_DIR=/var/lib/onto-web
# ONTO_WEB_ASSETS_DIR=/opt/onto-web/assets
# ONTO_WEB_PERMISSION_TIMEOUT=600
# 会话权限模式：bypassPermissions（默认全放行）或 default（逐操作确认卡）
# ONTO_WEB_PERMISSION_MODE=bypassPermissions

# 会话池（方案 4.1.1）：活跃子进程上限，8G 内存建议 12、16G 可按比例调高
# ONTO_WEB_MAX_SESSIONS=12
# 空闲会话回收阈值（秒，0 关闭）；回收后靠 resume 续接模型上下文
# 会话空闲回收秒数（默认 120）：连续对话零延迟，停顿超时释放子进程内存，下次消息自动 resume 续接
# ONTO_WEB_SESSION_IDLE_TTL=120
# 空闲回收的巡检间隔（秒，5–3600）
# ONTO_WEB_SESSION_REAPER_INTERVAL=30

# 定期备份间隔（小时，0 关闭；保留最近 3 份）；启动时距上次备份已超过间隔就先补一份
# ONTO_WEB_BACKUP_INTERVAL_HOURS=24
# 备份目录（默认数据目录下的 backups/，与数据同卷；建议挂独立卷后指向它）。
# 备份不含个人 Key 主密钥 .model-secret-key，须单独保管或用 ONTO_WEB_MODEL_SECRET_KEY 提供
# ONTO_WEB_BACKUP_DIR=/backups
# 自动生成的主密钥单独备份的目录（与备份里的密文分开放，建议另一个卷）；空 = 不单独备份
# ONTO_WEB_KEY_BACKUP_DIR=/key-backups

# ---- 运维管理面（同进程第二个监听，见 README「运维管理面」）----
# 运维监听地址与端口；端口 0 不起运维监听。运维面同样校验登录令牌
# ONTO_WEB_OPS_HOST=127.0.0.1
# ONTO_WEB_OPS_PORT=8101
# 业务面也处理 /api/v1/ops：compose 默认 true（单端口部署、没有反代时运维中心靠它，运维接口仍要
# 登录令牌与 ops 角色）；有反代把 /api/v1/ops/ 转到运维监听时设 false，业务面上返回 404。
# 不经 compose 直接运行后端时默认 false
# ONTO_WEB_OPS_ON_MAIN=true
# 前端访问运维面的地址；空 = 与业务面同源（由反代把 /api/v1/ops/ 转到运维监听）
# ONTO_WEB_OPS_BASE_URL=

# ---- 密钥与 agent 身份（见 README「密钥与 agent 身份」）----
# 密钥目录（管理员模型 Key、个人 Key 密文与自动主密钥、MCP token 库、服务令牌库），0700；
# 空 = 数据目录下的 secrets/。agent 读不到
# ONTO_WEB_SECRETS_DIR=
# agent 及其工具子进程使用的系统用户（镜像里已设为 onto-agent）；空 = 不切换（开发机）
# ONTO_WEB_AGENT_USER=onto-agent

# 日志级别（结构化 JSON 日志，另写数据目录 logs/，按日轮转保留 14 天）
# ONTO_WEB_LOG_LEVEL=INFO

# drawio 编辑器 webapp 目录（镜像内默认已设；缺席时前端降级为只读提示）
# ONTO_WEB_DRAWIO_DIR=/opt/onto-web/drawio

# 降级兼容包（无 AVX 环境的最后手段，见 deploy/README.md）：外部 JS 版 CLI 路径
# ONTO_WEB_CLI_PATH=

# 首次部署必填：auth-server 初始管理员密码（登录名 admin）；
# 首次启动写入用户库后即可从 .env 移除，修改登录密码请走界面
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# 登录鉴权（不配置则整体关闭；auth-server 仅应绑定回环地址）
# ONTO_WEB_AUTH_URL=http://127.0.0.1:5056
# ONTO_WEB_AUTH_ISSUER=http://127.0.0.1:5056
# ONTO_WEB_AUTH_AUDIENCE=meta-wise
# auth-server 管理 API 令牌（与 auth-server 的 AUTH_SERVER_ADMIN_TOKEN 相同）：运维中心「用户与审计」要它，没配时用户管理不可用
# ONTO_WEB_AUTH_ADMIN_TOKEN=

# ---- 账号中心（可选：接入既有 consumer/modeling 栈的 auth-server，实现单点账号）----
# 两项同时设置后重新执行 deploy.sh：自带 auth-server 停用，
# onto-modeling 加入 consumer 栈网络直接复用其用户库。
# ONTO_MODELING_AUTH_URL=http://auth-server:5056
# ONTO_MODELING_EXTERNAL_AUTH_NETWORK=consumer_onto-agent-network

# ---- 模型上下文约束（可选）：部署级兜底，变量名与会话引擎无关 ----
# 优先级：配置中心「模型接入 → 上下文与自动压缩」填写值 > 这里 > 内置默认
# （模型真实窗口 200000，最大输出 32000）。非法或越界的值会被忽略并在服务日志中告警。
# 改动后需重建容器生效（docker compose up -d；restart 不会重读 .env）。
# 模型真实窗口（输入 + 输出），1000–10000000；接入窗口小于 200K 的模型必须设置
# ONTO_WEB_CONTEXT_WINDOW=200000
# 每次请求的最大输出 token，1000–1000000，须小于真实窗口
# ONTO_WEB_CONTEXT_MAX_OUTPUT_TOKENS=32000
# 压缩窗口与触发百分比只能在这里配置，配置页不提供。两者都不设时按生效的窗口与最大输出
# 自动推算，使压缩前的请求给模型窗口留至少 10% 余量；设了任一项就完全按这里，不再推算。
# 压缩窗口，100000–1000000，只能比真实窗口小
# ONTO_WEB_CONTEXT_COMPACT_WINDOW=
# 自动压缩触发百分比，1–100，只能比默认阈值更早
# ONTO_WEB_CONTEXT_COMPACT_PCT=

# ---- Jiuwen 引擎（可选，灰度）：OpenAI 兼容模型直连（Qwen/DeepSeek/GLM 等）----
# 部署级兜底配置；管理员也可在「配置中心 → 模型接入」界面配置（界面优先）。
# 引擎按项目切换：项目卡片「更多 → 会话引擎」。
ONTO_WEB_JIUWEN_BASE_URL=
ONTO_WEB_JIUWEN_API_KEY=
ONTO_WEB_JIUWEN_MODEL=
# 内测引擎的上下文窗口与最大输出另存一组（配置页「上下文与自动压缩（内测引擎）」），留空时同样
# 回落上面的 ONTO_WEB_CONTEXT_WINDOW / ONTO_WEB_CONTEXT_MAX_OUTPUT_TOKENS；两处都没配时最大输出
# 按这里（默认 32000，与稳定引擎一致；输出上限更小的模型须填写，否则请求会被拒绝）。
# 压缩触发点按窗口与最大输出自动推算
# ONTO_WEB_JIUWEN_MAX_TOKENS=32000
# 内测引擎的会话放在独立 worker 子进程里（出错不拖垮后端）；false 退回在后端进程内运行
# ONTO_WEB_JIUWEN_WORKER=true
# 内测引擎单轮最大迭代（1–1000）
# ONTO_WEB_JIUWEN_MAX_ITERATIONS=60

# ---- 个人 API Key：成员在「设置 → 我的模型配置」用自己的 Key 覆盖管理员配置 ----
# 必须配置（至少 32 字节）：个人 Key 用该主密钥加密落盘。没配时启动告警，并在密钥目录自动生成
# .model-secret-key（0600）；它不进数据备份（可用 ONTO_WEB_KEY_BACKUP_DIR 单独备份），异机恢复
# 缺了它，个人 Key 解不开。更换主密钥后已存的个人 Key 需成员重新保存。
# 管理员可在「配置中心 → 模型接入」关闭个人 Key。
# ONTO_WEB_MODEL_SECRET_KEY=${MODEL_SECRET_KEY}

# ---- 评测服务对接：不需要环境变量 ----
# 评测已移出 onto-modeling（ADR-0020），onto 不主动调用评测服务。评测服务持管理员在
# /api/v1/admin/service-tokens 签发的服务令牌（onto_svc_…），调用发布记录与下载、求解验证回执、
# 外部反馈三组接口。

# ---- 脚本验证沙箱网关（代码生成、脚本节点；compose 里已按服务名配好）----
# 后端访问网关的地址；空 = 不连沙箱（脚本验证与脚本节点回「沙箱不可用」）
# ONTO_WEB_SANDBOX_GATEWAY_URL=http://sandbox-gateway:8110
# 网关自己的监听端口（网关容器读）
# ONTO_WEB_SANDBOX_GATEWAY_PORT=8110

# ---- 项目级本地 MCP 的公开地址（反向代理部署时用）；空 = 按访问工作台的地址生成 ----
# ONTO_WEB_MCP_PUBLIC_BASE_URL=https://onto.example.com
