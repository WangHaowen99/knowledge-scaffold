MODELING_AGENT_DATA_DIR=./data/agent
MODELING_CORE_BASE_URL=http://127.0.0.1:5100
MODELING_LLM_BASE_URL=https://example.invalid/v1
MODELING_LLM_MODEL=your-model
MODELING_LLM_API_KEY=
MODELING_LLM_MAX_TOKENS=32768
# 目标/流程生成预算；不要与短摘要预算混用。
MODELING_GOAL_OUTPUT_TOKENS=8192
# 资料分段分析预算；长资料建议至少 8192。
MODELING_ANALYST_OUTPUT_TOKENS=8192
# 空正文恢复时的短摘要预算。
MODELING_SUMMARY_OUTPUT_TOKENS=1024
MODELING_AGENT_MAX_ITERATIONS=200
# requiredText 语义守卫：off / observe / enforce（默认 enforce；可先用 observe 观测旧模型）。
MODELING_REQUIRED_TEXT_GUARD_MODE=enforce
