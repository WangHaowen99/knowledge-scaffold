# nl2sql-service 部署配置。deploy.sh 首次运行时复制本文件为 .env（权限 600），
# 并为留空的 EVAL_MYSQL_ROOT_PASSWORD、NL2SQL_DB_PASSWORD、NL2SQL_TOKEN 生成随机值（不回显）。

# ---- 生成 SQL 用的模型（OpenAI 兼容 /chat/completions；BASE_URL 和 MODEL 必填）----
# 模型网关在宿主机上时，地址用 host.docker.internal 代替 localhost
MODELING_LLM_BASE_URL=
MODELING_LLM_MODEL=
MODELING_LLM_API_KEY=

# ---- 访问凭据（留空由 deploy.sh 生成；自行设置时只用字母和数字）----
# consumer 配置 nl2sql_http / nl2sql_template 数据源时，填到「访问 Token」
NL2SQL_TOKEN=
# MySQL root 密码，只用于建库和导入数据
EVAL_MYSQL_ROOT_PASSWORD=
# NL2SQL 查询用的只读账号 nl2sql_reader 的密码
NL2SQL_DB_PASSWORD=

# ---- 端口与网络 ----
# NL2SQL 宿主端口的绑定地址，默认只允许本机访问；consumer 在其他机器上时改为内网地址，不要绑到公网
NL2SQL_BIND_ADDRESS=127.0.0.1
NL2SQL_PORT=5600
# MySQL 宿主端口的绑定地址，供本机导入数据；不要随 NL2SQL 一起放开
EVAL_MYSQL_BIND_ADDRESS=127.0.0.1
EVAL_MYSQL_PORT=3306
# consumer 的 Docker 网络名（docker network ls 查看）。填写后只有 nl2sql-service 加入该网络，
# consumer 用 http://nl2sql-service:5600 访问 NL2SQL；MySQL 不加入
NL2SQL_EXTERNAL_NETWORK=

# 请求没带 scene 时查询的数据库
NL2SQL_DEFAULT_SCENE=default
