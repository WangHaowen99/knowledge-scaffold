# auth server 配置（全部通过环境变量，config.py 读取）

# 数据目录：users.json 与 keys/ 私钥所在（容器内建议 /data 并挂卷）
AUTH_SERVER_DATA_DIR=./data

# JWT iss / aud（consumer 侧验签必须使用相同取值）
AUTH_SERVER_ISSUER=http://auth-server:5056
AUTH_SERVER_AUDIENCE=meta-wise

# access token TTL（秒）。硬上限 3600：超过会被钳制并打日志警告（架构决策 D2）
AUTH_ACCESS_TTL_SECONDS=900
# refresh token TTL（秒），默认 72 小时
AUTH_REFRESH_TTL_SECONDS=259200

# Admin API 共享密钥（请求头 X-Admin-Token）。不配置则 /admin/* 一律 503
AUTH_SERVER_ADMIN_TOKEN=

# 首次创建 users.json 时使用的管理员初始密码；须符合密码策略，且不得与其他密钥复用。
# users.json 已存在时无需保留该变量。
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# 监听地址与端口
AUTH_SERVER_HOST=127.0.0.1
AUTH_SERVER_PORT=5056

# 用户数量上限；设为 0 表示不限制
AUTH_USER_MAX_COUNT=1000

# 自助注册默认开启。设为 false 可关闭 /register（未关闭时一步直接建号，无邮箱验证码）
AUTH_ENABLE_REGISTRATION=true
