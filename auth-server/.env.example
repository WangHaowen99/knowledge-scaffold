# auth server 配置（全部通过环境变量，config.py 读取）

# 数据目录：users.json 与 keys/ 私钥所在（容器内建议 /data 并挂卷）
AUTH_SERVER_DATA_DIR=./data

# JWT iss / aud（consumer 侧验签必须使用相同取值）
AUTH_SERVER_ISSUER=http://auth-server:5056
AUTH_SERVER_AUDIENCE=meta-wise

# access token TTL（秒）。硬上限 3600：超过会被钳制并打日志警告（架构决策 D2）
AUTH_ACCESS_TTL_SECONDS=900
# refresh token TTL（秒），默认 72 小时
AUTH_REFRESH_TTL_SECONDS=259200

# Admin API 共享密钥（请求头 X-Admin-Token）。不配置则 /admin/* 一律 503
AUTH_SERVER_ADMIN_TOKEN=

# 监听地址与端口
AUTH_SERVER_HOST=127.0.0.1
AUTH_SERVER_PORT=5056

# 用户数量上限（与 consumer USER_MAX_COUNT 语义一致；待验证注册不计入，创建时再查）
AUTH_USER_MAX_COUNT=10

# 开放注册（opt-in，默认关闭）。开启后暴露 /register、/register/verify、/register/resend
AUTH_ENABLE_REGISTRATION=false

# 邮件发送模式：smtp | console（console 把验证码打日志，仅供开发/测试）
AUTH_MAIL_MODE=console

# SMTP 配置（AUTH_MAIL_MODE=smtp 时必填 HOST；未配置则注册端点 503 并在启动时打警告）
# 端口 465 走隐式 SSL，其余端口按 AUTH_SMTP_USE_TLS 决定是否 STARTTLS
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_USE_TLS=true
AUTH_MAIL_FROM=no-reply@meta-wise.local
