# Repository build contexts are used by the Consumer and standalone
# Connector images.  Keep public source/contracts, but never send local
# credentials, runtime state, generated artifacts, or test caches to Docker.
.git/
.worktrees/
.codex/
.gstack/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.env
**/.env.*
.env
.env.*
**/logs/
**/*.log
**/.onto-runtime/
**/.onto-auth/
**/dist/
**/build/
**/node_modules/
**/.venv/
**/venv/
**/data/
*.tar
*.tar.gz
*.zip
